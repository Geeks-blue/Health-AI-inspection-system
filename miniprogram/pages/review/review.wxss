.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
}
.counter {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  background: var(--c-primary-soft);
  border-radius: 12rpx;
  min-width: 120rpx;
}
.counter .num { font-size: 44rpx; font-weight: 600; color: var(--c-primary-dark); }
.counter .label { font-size: 22rpx; color: var(--c-primary-dark); }

.review-item { margin-top: 16rpx; }
.review-item .top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.review-item .room-tag {
  background: var(--c-primary);
  color: #fff;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.review-item .meta { flex: 1; }
.review-item .uploader { font-size: 26rpx; color: var(--c-text-2); }
.review-item .time { font-size: 22rpx; color: var(--c-muted); margin-top: 4rpx; }

.reason {
  background: var(--c-warn-soft);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin: 16rpx 0 20rpx;
}
.reason-label { font-size: 22rpx; color: var(--c-warn); font-weight: 600; }
.reason-text  { font-size: 26rpx; color: var(--c-text); margin-top: 4rpx; }
