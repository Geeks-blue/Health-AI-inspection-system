<view class="page">
  <!-- 顶部欢迎条 -->
  <view class="user-bar" wx:if="{{user}}">
    <view class="avatar">{{userInitial}}</view>
    <view class="meta">
      <view class="name">{{user.id}}</view>
      <view class="role">{{user.role}}</view>
    </view>
  </view>

  <!-- 教室选择 -->
  <view class="section card">
    <view class="section-title">
      <view class="title">选择教室</view>
      <view class="sub" wx:if="{{claimedRoom}}">已选 · {{claimedRoom}}</view>
      <view class="sub" wx:else>共 {{rooms.length}} 间</view>
    </view>
    <view class="hint">点选一间空闲教室即可锁定上传位（5 分钟内有效）；再点一次取消选择；上传成功自动释放。</view>

    <view class="room-grid">
      <view wx:for="{{rooms}}" wx:key="id"
            class="room {{item.isSelf ? 'room-self' : ''}} {{item.isOther ? 'room-locked' : ''}}"
            data-room="{{item}}"
            bindtap="pickRoom">
        <view class="room-id">{{item.id}}</view>
        <view class="room-name">{{item.name}}</view>
        <view class="room-status" wx:if="{{item.isSelf}}">✓ 已选 · 再点取消</view>
        <view class="room-status" wx:elif="{{item.isOther}}">占用：{{item.lockedBy}}</view>
        <view class="room-status free" wx:else>空闲</view>
      </view>
    </view>

    <view wx:if="{{rooms.length === 0}}" class="empty">
      <view class="icon">🏫</view>
      <view class="text">教室列表加载中…</view>
    </view>
  </view>

  <!-- 拍照区 -->
  <view class="section card">
    <view class="section-title">
      <view class="title">教室照片</view>
      <view class="sub" wx:if="{{!photoPath}}">尚未选择</view>
    </view>

    <view wx:if="{{!photoPath}}" class="photo-picker" bindtap="chooseImage">
      <view class="picker-icon">📷</view>
      <view class="picker-text">点击拍照 / 选择图片</view>
    </view>

    <view wx:else class="photo-preview">
      <image src="{{photoPath}}" mode="widthFix" class="preview-img" />
      <view class="preview-actions">
        <button class="btn ghost small" bindtap="chooseImage">重拍</button>
        <button class="btn ghost small" bindtap="removePhoto">删除</button>
      </view>
    </view>
  </view>

  <!-- 上次结果 -->
  <view wx:if="{{result}}" class="section card">
    <view class="section-title">
      <view class="title">上次判定</view>
    </view>
    <view class="result-line">
      <text class="result-label">结果</text>
      <view class="badge {{result.result}}">{{result.result === 'pass' ? '合格' : '待复核'}}</view>
    </view>
    <view class="result-line">
      <text class="result-label">原因</text>
      <text class="muted">{{result.reason}}</text>
    </view>
    <view class="result-line">
      <text class="result-label">记录</text>
      <text class="muted">#{{result.record_id}}</text>
    </view>
  </view>
</view>

<!-- 底部固定操作栏 -->
<view class="actionbar">
  <view class="action-meta">
    <text wx:if="{{claimedRoom}}">已选：{{claimedRoom}}</text>
    <text wx:else class="muted">未选择教室</text>
  </view>
  <view class="action-btns">
    <button class="btn small" loading="{{submitting}}" disabled="{{submitting || !claimedRoom || !photoPath}}" bindtap="submit">
      提交
    </button>
  </view>
</view>
