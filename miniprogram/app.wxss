/* 全局样式：简洁卡片风格 */
page {
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #333;
}
.btn-primary {
  background-color: #1aad19;
  color: #fff;
}
.card {
  background: #fff;
  padding: 24rpx;
  margin: 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}
.muted { color: #888; font-size: 24rpx; }
