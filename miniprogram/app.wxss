/* 全局设计令牌：色 / 圆角 / 间距 / 阴影 */
page {
  --c-primary: #1890ff;
  --c-primary-dark: #096dd9;
  --c-primary-soft: #e6f4ff;
  --c-warn: #faad14;
  --c-warn-soft: #fff7e6;
  --c-danger: #f5222d;
  --c-danger-soft: #fff1f0;
  --c-text: #1f1f1f;
  --c-text-2: #595959;
  --c-muted: #8c8c8c;
  --c-border: #f0f0f0;
  --c-bg: #f4f6fa;

  background-color: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text { box-sizing: border-box; }

/* ===== 通用容器 ===== */
.page { padding: 24rpx 24rpx 160rpx; }
.section + .section { margin-top: 24rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title .title { font-size: 32rpx; font-weight: 600; }
.section-title .sub   { color: var(--c-muted); font-size: 24rpx; }

.hint { color: var(--c-muted); font-size: 24rpx; line-height: 1.6; }
.muted { color: var(--c-muted); }

/* ===== 按钮 ===== */
.btn {
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 22rpx 32rpx;
  background: var(--c-primary);
  color: #fff;
  border: none;
  line-height: 1.2;
}
.btn::after { border: none; }
.btn[disabled] { background: #bfbfbf !important; color: #fff !important; }

.btn.block { width: 100%; }
.btn.ghost { background: #fff; color: var(--c-primary); border: 2rpx solid var(--c-primary); }
.btn.ghost[disabled] { color: #bfbfbf !important; border-color: #d9d9d9 !important; background: #fff !important; }
.btn.danger { background: var(--c-danger); }
.btn.small { padding: 14rpx 24rpx; font-size: 26rpx; border-radius: 8rpx; }

.btn-row {
  display: flex;
  gap: 16rpx;
}
.btn-row .btn { flex: 1; }

/* ===== 徽标 ===== */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
.badge.pass   { background: var(--c-primary-soft); color: var(--c-primary-dark); }
.badge.review { background: var(--c-warn-soft);    color: var(--c-warn); }
.badge.fail   { background: var(--c-danger-soft);  color: var(--c-danger); }

/* ===== 表单 ===== */
.input {
  background: var(--c-bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.label {
  font-size: 26rpx;
  color: var(--c-text-2);
  margin-bottom: 12rpx;
}

/* ===== 空状态 / 加载 ===== */
.empty {
  text-align: center;
  padding: 80rpx 24rpx;
}
.empty .icon { font-size: 96rpx; }
.empty .text { color: var(--c-muted); margin-top: 16rpx; }

/* ===== 顶部状态条 (登录用户信息) ===== */
.user-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
  border-radius: 16rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.user-bar .avatar {
  width: 80rpx; height: 80rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
}
.user-bar .meta { flex: 1; }
.user-bar .meta .name { font-size: 32rpx; font-weight: 600; }
.user-bar .meta .role { font-size: 24rpx; opacity: 0.85; }
